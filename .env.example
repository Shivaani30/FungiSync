# Application
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:5173

# Replace placeholders locally. Supply migration/test variables only to their
# dedicated commands; do not put admin credentials in the application process.
# Use a protected PGPASSFILE or a secret manager for passwords, never tracked files.
APP_DATABASE_URL=postgresql+psycopg://fungisync_app_runtime@<host>:<port>/<application-database>
# MIGRATION_DATABASE_URL=postgresql+psycopg://fungisync_migration_admin@<host>:<port>/<migration-database>
# TEST_RUNTIME_DATABASE_URL=postgresql+psycopg://fungisync_app_runtime@<isolated-host>:<isolated-port>/fungisync_test_db
# TEST_ADMIN_DATABASE_URL=postgresql+psycopg://fungisync_migration_admin@<isolated-host>:<isolated-port>/fungisync_test_db
# TEST_EXPECTED_CLUSTER_SYSTEM_ID=<verified-isolated-system-identifier>
# TEST_EXPECTED_DATA_DIRECTORY=<verified-isolated-data-directory>
# Required lifetime for a submitted proposal's PENDING reservations.
RESERVATION_PENDING_TTL_SECONDS=3600

# Used only by Docker Compose for a local PostgreSQL container.
POSTGRES_USER=<postgres-user>
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=<postgres-database>
