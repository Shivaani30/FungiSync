# Application
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:5173

# Replace every angle-bracket placeholder; do not commit the resulting .env file.
DATABASE_URL=postgresql+psycopg://<postgres-user>:<postgres-password>@localhost:5432/<postgres-database>
TEST_DATABASE_URL=postgresql+psycopg://<postgres-user>:<postgres-password>@localhost:5433/fungisync_test_db
# Required lifetime for a submitted proposal's PENDING reservations.
RESERVATION_PENDING_TTL_SECONDS=3600

# Used only by Docker Compose for a local PostgreSQL container.
POSTGRES_USER=<postgres-user>
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=<postgres-database>
